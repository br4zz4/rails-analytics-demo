<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Rails Analytics Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Rails Analytics Demo">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>

    <%= rails_analytics_tracker_tag %>
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header-inner">
        <a href="/" class="brand">Acme Store</a>
        <nav class="site-nav">
          <a href="/">Home</a>
          <a href="/blog">Blog</a>
          <a href="/produtos">Produtos</a>
          <a href="/contato">Contato</a>
        </nav>
        <a class="btn btn-outline" href="/rails_analytics" target="_blank">📊 Dashboard</a>
      </div>
    </header>

    <main class="container site-main">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>App demonstração para a gem <strong>rails_analytics</strong> — tráfego coletado via POST anônimo, sem cookies, com IP mascarado.</p>
        <p><a href="/rails_analytics" target="_blank">Abrir dashboard →</a></p>
      </div>
    </footer>
  </body>
</html>