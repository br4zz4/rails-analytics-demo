<% content_for :title, "Contato — Acme Store" %>

<div class="contact-wrap">
  <h1 class="page-title">Contato</h1>
  <p class="contact-lead">Formulário fictício — o importante aqui é que esta página também gera uma visita no analytics.</p>
  <form class="contact-form" onsubmit="return false">
    <label>Nome
      <input type="text" placeholder="Seu nome">
    </label>
    <label>E-mail
      <input type="email" placeholder="voce@exemplo.com">
    </label>
    <label>Mensagem
      <textarea rows="4" placeholder="Escreva aqui..."></textarea>
    </label>
    <button class="btn btn-primary" type="submit">Enviar mensagem</button>
  </form>
</div>