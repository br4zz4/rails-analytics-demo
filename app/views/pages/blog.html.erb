<% content_for :title, "Blog — Acme Store" %>

<h1 class="page-title">Blog</h1>

<div class="post-grid">
  <% @posts.each do |slug, post| %>
    <a class="post-card" href="/blog/<%= slug %>">
      <h3><%= post[:title] %></h3>
      <p><%= post[:excerpt] %></p>
      <span class="post-link">Ler →</span>
    </a>
  <% end %>
</div>